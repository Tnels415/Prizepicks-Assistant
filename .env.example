# The Odds API — get a free key (500 req/month) at: https://the-odds-api.com/
# This powers automatic daily prop line fetching from DraftKings/FanDuel/BetMGM
THE_ODDS_API_KEY=your_odds_api_key_here

# balldontlie.io — optional fallback for player lookups (free at balldontlie.io)
BALLDONTLIE_API_KEY=your_free_key_here

# Gmail credentials for sending the daily report
EMAIL_FROM=sender@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_TO=tnelson8822@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Regional sports networks / streaming services you can watch (comma-separated).
# National broadcasts (ESPN, TNT, ABC, FOX, NBC, MLB Network, etc.) are ALWAYS
# treated as watchable. Add your RSNs/streamers here so the email's
# "Watchable on TV" section includes your local teams' regional games.
# Example: TV_NETWORKS=NBC Sports Bay Area,Bally Sports,YES Network
TV_NETWORKS=
